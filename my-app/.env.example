# Copy to .env.local (git-ignored) for local dev, and add the same variable in
# Vercel → Project → Settings → Environment Variables, then redeploy.

# Password for /invoice, stored as a SHA-256 hash (never the password itself).
# Generate the hash (replace PasswordBaru with your new password):
#   node -e "console.log(require('crypto').createHash('sha256').update('bryan-invoice:' + process.argv[1]).digest('hex'))" "PasswordBaru"
VITE_INVOICE_PASS_HASH=
